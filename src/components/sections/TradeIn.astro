---
import Icon from '../Icon.astro';
import { waTradeIn } from '../../data/site';

const steps = [
  'Envie pelo WhatsApp o modelo, a capacidade e o estado do seu iPhone.',
  'Receba a avaliação do seu aparelho.',
  'Use o valor como parte do pagamento do novo.',
];
---
<section id="troca" class="py-20 sm:py-28" aria-labelledby="troca-title">
  <div class="container-x">
    <div class="reveal grid gap-10 rounded-[32px] border border-ink/[0.08] p-6 sm:p-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16 lg:p-14">
      <div>
        <p class="eyebrow">Troca do usado</p>
        <h2 id="troca-title" class="mt-4 text-3xl leading-tight font-semibold sm:text-4xl">Seu iPhone usado pode entrar no pagamento.</h2>
        <a href={waTradeIn()} target="_blank" rel="noopener" class="btn btn-ghost mt-7">
          Quanto vale meu iPhone usado?
          <Icon name="arrow" class="btn-arrow size-4" />
        </a>
      </div>
      <ol class="grid gap-3">
        {
          steps.map((s, i) => (
            <li class="flex items-center gap-4 rounded-2xl bg-mist p-4 sm:p-5">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-ink text-sm font-semibold text-paper tabular-nums">{i + 1}</span>
              <span class="text-[0.9375rem] text-ink">{s}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
