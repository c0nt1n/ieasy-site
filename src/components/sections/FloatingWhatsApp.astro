---
import Icon from '../Icon.astro';
import { waGeneral } from '../../data/site';
---
<a
  href={waGeneral()}
  target="_blank"
  rel="noopener"
  class="glass-dark group fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-40 flex h-14 items-center rounded-full pr-4 pl-4 text-paper shadow-[0_18px_40px_-14px_rgb(0_0_0/0.6)] ring-1 ring-paper/15 transition-transform duration-300 ease-out-soft hover:-translate-y-0.5 active:scale-95 sm:right-6 sm:bottom-6"
  aria-label="Falar no WhatsApp"
>
  <Icon name="whatsapp" class="size-6" />
  <span class="hidden max-w-0 overflow-hidden text-sm font-medium whitespace-nowrap transition-[max-width,margin] duration-500 ease-out-soft group-hover:ml-2 group-hover:max-w-40 group-focus-visible:ml-2 group-focus-visible:max-w-40 sm:inline">Falar no WhatsApp</span>
</a>
