---
import Icon from '../Icon.astro';
import { waGeneral } from '../../data/site';
---
<!-- Botão fixo do WhatsApp: acompanha a rolagem em todas as telas.
     A borda branca garante que ele apareça também sobre as seções pretas. -->
<a
  href={waGeneral()}
  target="_blank"
  rel="noopener"
  class="fab-in fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-40 grid size-15 place-items-center rounded-full bg-ink text-paper shadow-[0_14px_34px_-10px_rgb(0_0_0/0.55)] ring-2 ring-paper transition-[translate,scale,background-color] duration-300 ease-out-soft hover:-translate-y-1 hover:bg-graphite active:scale-95 sm:right-8 sm:bottom-8 sm:size-16"
  aria-label="Falar no WhatsApp"
>
  <span class="fab-ring pointer-events-none absolute inset-0 rounded-full ring-2 ring-ink/40" aria-hidden="true"></span>
  <Icon name="whatsapp" class="relative size-8" />
</a>
