---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import DeviceGlyph from '../DeviceGlyph.astro';
import ProductCard from '../ProductCard.astro';
import { categories, productsBy, type Category } from '../../data/products';
import { waGeneral } from '../../data/site';
import fanLeft from '../../assets/categorias/iphone-18-pro-max-glacial.png';
import fanCenter from '../../assets/categorias/iphone-17-pro-max-laranja-cosmico.png';
import fanRight from '../../assets/categorias/iphone-18-pro-max-bordo.png';

// Leque de iPhones no bloco da categoria (recortes sem fundo, de trás para a frente)
const iphoneFan = [
  { src: fanLeft, pos: 'fan-l' },
  { src: fanRight, pos: 'fan-r' },
  { src: fanCenter, pos: 'fan-c' },
];

// Escada de MacBook Neo no bloco do MacBook (de trás para a frente)
import macSilver from '../../assets/categorias/macbook-neo-prateado.png';
import macIndigo from '../../assets/categorias/macbook-neo-indigo.png';
import macBlush from '../../assets/categorias/macbook-neo-blush.png';
import macCitrus from '../../assets/categorias/macbook-neo-amarelo-citrico.png';
const macStack = [
  { src: macSilver, pos: 'stack-4' },
  { src: macIndigo, pos: 'stack-3' },
  { src: macBlush, pos: 'stack-2' },
  { src: macCitrus, pos: 'stack-1' },
];

// Trio de iPads no bloco do iPad (de trás para a frente)
import ipadYellow from '../../assets/categorias/ipad-11-a16-amarelo.png';
import ipadPink from '../../assets/categorias/ipad-11-a16-rosa.png';
import ipadBlue from '../../assets/categorias/ipad-11-a16-azul.png';
const ipadTrio = [
  { src: ipadYellow, pos: 'trio-3' },
  { src: ipadPink, pos: 'trio-2' },
  { src: ipadBlue, pos: 'trio-1' },
];

// Posição de cada linha na grade bento (desktop: 4 colunas)
const bento: Record<Category, string> = {
  iphone: 'col-span-2 row-span-2 lg:col-span-2 lg:row-span-2',
  macbook: 'col-span-2 lg:col-span-2',
  ipad: 'col-span-1',
  airpods: 'col-span-1',
  watch: 'col-span-1 lg:col-span-2',
  acessorios: 'col-span-1 lg:col-span-2',
};
---
<section id="produtos" class="py-20 sm:py-28" aria-labelledby="produtos-title">
  <div class="container-x">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Produtos</p>
      <h2 id="produtos-title" class="section-title mt-4">Escolha o seu. A gente cuida do resto.</h2>
      <p class="lead mt-5">
        Todos originais e lacrados. Veja as cores e capacidades de cada modelo e confirme a disponibilidade no WhatsApp.
      </p>
    </div>

    <!-- Grade bento das linhas de produto -->
    <ul class="mt-12 grid auto-rows-[minmax(150px,auto)] grid-cols-2 gap-3 sm:gap-4 lg:auto-rows-[200px] lg:grid-cols-4">
      {
        categories.map((c) => {
          const count = productsBy(c.id).length;
          const dark = c.id === 'iphone';
          return (
            <li class:list={['reveal', bento[c.id]]}>
              <a
                href={`#linha-${c.id}`}
                class:list={[
                  'tilt group relative flex h-full flex-col justify-between overflow-hidden rounded-[28px] p-5 sm:p-6',
                  dark ? 'on-dark bg-ink text-paper' : 'bg-mist text-ink ring-1 ring-ink/[0.04]',
                ]}
              >
                {c.id === 'iphone' ? (
                  <>
                    <span class="fan pointer-events-none absolute inset-y-0 right-0 w-[72%] sm:w-[60%]" aria-hidden="true">
                      {iphoneFan.map((f) => (
                        <span class:list={['fan-item', f.pos]}>
                          <Image src={f.src} alt="" widths={[160, 240, 320, 480]} sizes="(min-width: 1024px) 260px, 40vw" class="h-full w-auto" />
                        </span>
                      ))}
                    </span>
                    <span class="pointer-events-none absolute inset-0 bg-linear-to-r from-ink from-10% via-ink/50 via-35% to-transparent to-55%" aria-hidden="true" />
                  </>
                ) : c.id === 'macbook' ? (
                  <span class="pointer-events-none absolute inset-y-0 right-0 w-[62%] sm:w-[55%]" aria-hidden="true">
                    {macStack.map((m) => (
                      <span class:list={['stack-item', m.pos]}>
                        <Image src={m.src} alt="" widths={[160, 240, 320, 480]} sizes="(min-width: 1024px) 200px, 35vw" quality={92} class="h-full w-auto" />
                      </span>
                    ))}
                  </span>
                ) : c.id === 'ipad' ? (
                  <span class="pointer-events-none absolute inset-y-0 right-0 w-[58%]" aria-hidden="true">
                    {ipadTrio.map((m) => (
                      <span class:list={['trio-item', m.pos]}>
                        <Image src={m.src} alt="" widths={[120, 180, 240, 360]} sizes="(min-width: 1024px) 120px, 25vw" quality={92} class="h-full w-auto" />
                      </span>
                    ))}
                  </span>
                ) : (
                  <DeviceGlyph
                    category={c.id}
                    class="pointer-events-none absolute top-3 right-3 w-[24%] max-w-24 text-steel/70 transition-transform duration-700 ease-out-soft group-hover:scale-105 lg:top-4 lg:right-4"
                  />
                )}
                <span class:list={['relative text-xs font-medium', dark ? 'text-mist' : 'text-graphite']}>
                  {count} {count === 1 ? 'modelo' : 'modelos'}
                </span>
                <span class="relative">
                  <span class:list={['block font-display font-semibold tracking-tight', dark ? 'text-3xl text-paper sm:text-5xl' : 'text-xl sm:text-2xl']}>
                    {c.name}
                  </span>
                  <span
                    class:list={[
                      'mt-1 block text-sm',
                      // no iPad os aparelhos ocupam a metade direita: a frase quebra antes deles,
                      // e some no bloco estreito do desktop (como já acontece no celular)
                      c.id === 'ipad' ? 'max-w-[48%] lg:hidden' : 'max-w-[16rem]',
                      dark ? 'text-mist' : 'text-graphite',
                      !dark && 'hidden sm:block',
                    ]}
                  >
                    {c.tagline}
                  </span>
                  <span
                    class:list={[
                      'mt-4 inline-grid size-9 place-items-center rounded-full transition-transform duration-500 ease-out-soft group-hover:translate-x-1',
                      dark ? 'bg-paper text-ink' : 'bg-ink text-paper',
                    ]}
                  >
                    <Icon name="arrow" class="size-4" />
                  </span>
                  <span class="sr-only">Ver modelos de {c.name}</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <!-- Catálogo por linha -->
    <div class="mt-20 space-y-20 sm:mt-28 sm:space-y-24">
      {
        categories.map((c) => (
          <div id={`linha-${c.id}`} class="scroll-mt-24" aria-labelledby={`linha-${c.id}-title`} role="region">
            <div class="reveal flex flex-wrap items-end justify-between gap-4 border-b border-ink/[0.08] pb-5">
              <div>
                <h3 id={`linha-${c.id}-title`} class="text-2xl font-semibold sm:text-3xl">{c.name}</h3>
                <p class="mt-1 text-sm text-graphite">{c.tagline}</p>
              </div>
              <a href={waGeneral(c.name)} target="_blank" rel="noopener" class="group inline-flex items-center gap-1.5 text-sm font-medium text-ink underline-offset-4 hover:underline">
                Perguntar sobre {c.name}
                <Icon name="arrow-up-right" class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </a>
            </div>

            <ul class="mt-6 grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 lg:grid-cols-4">
              {productsBy(c.id).map((p) => (
                <li class="reveal">
                  <ProductCard product={p} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Leque de iPhones: o do meio na frente, os outros inclinados atrás. Abre um pouco no hover. */
  .fan-item {
    position: absolute;
    bottom: -10%;
    display: block;
    transform-origin: 50% 100%;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    filter: drop-shadow(0 18px 30px rgb(0 0 0 / 0.55));
  }
  .fan-c {
    height: 84%;
    left: 50%;
    transform: translateX(-50%);
  }
  .fan-l,
  .fan-r {
    height: 70%;
    left: 50%;
  }
  .fan-l {
    transform: translateX(-108%) rotate(-10deg);
  }
  .fan-r {
    transform: translateX(8%) rotate(10deg);
  }
  .group:hover .fan-c {
    transform: translateX(-50%) translateY(-3%);
  }
  .group:hover .fan-l {
    transform: translateX(-118%) rotate(-14deg);
  }
  .group:hover .fan-r {
    transform: translateX(18%) rotate(14deg);
  }

  /* Escada de MacBooks: o da frente embaixo, os outros subindo para a direita. Espalha um pouco no hover. */
  .stack-item {
    position: absolute;
    display: block;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    filter: drop-shadow(0 14px 18px rgb(0 0 0 / 0.16));
  }
  .stack-1 {
    right: 30%;
    bottom: -6%;
    height: 68%;
  }
  .stack-2 {
    right: 20%;
    bottom: 10%;
    height: 60%;
  }
  .stack-3 {
    right: 10%;
    bottom: 24%;
    height: 52%;
  }
  .stack-4 {
    right: 0;
    bottom: 38%;
    height: 44%;
  }
  .group:hover .stack-1 {
    transform: translate(-8%, 2%);
  }
  .group:hover .stack-2 {
    transform: translate(-3%, 0);
  }
  .group:hover .stack-3 {
    transform: translate(3%, -2%);
  }
  .group:hover .stack-4 {
    transform: translate(8%, -4%);
  }

  /* Trio de iPads: o azul na frente, rosa e amarelo atrás, subindo para a direita */
  .trio-item {
    position: absolute;
    display: block;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    filter: drop-shadow(0 12px 16px rgb(0 0 0 / 0.16));
  }
  .trio-1 {
    right: 34%;
    bottom: -12%;
    height: 82%;
  }
  .trio-2 {
    right: 16%;
    bottom: -4%;
    height: 78%;
  }
  .trio-3 {
    right: -2%;
    bottom: 4%;
    height: 74%;
  }
  .group:hover .trio-1 {
    transform: translate(-10%, -2%) rotate(-3deg);
  }
  .group:hover .trio-3 {
    transform: translate(8%, -3%) rotate(3deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .trio-item,
    .stack-item,
    .fan-item {
      transition: none;
    }
  }
</style>
