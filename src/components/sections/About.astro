---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';
import { site, hoursInline, waGeneral } from '../../data/site';

const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/equipe/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photo = site.foundersPhoto ? photos[`/src/assets/equipe/${site.foundersPhoto}`]?.default : undefined;
const names = site.founders.map((f) => f.name).join(' e ');
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter((_, i, all) => i === 0 || i === all.length - 1)
    .map((w) => w[0].toUpperCase())
    .join('');
---
<section id="quem-somos" class="py-20 sm:py-28" aria-labelledby="sobre-title">
  <div class="container-x grid items-center gap-10 md:grid-cols-[0.9fr_1.1fr] lg:gap-20">
    <!-- Foto dos dois sócios juntos; sem foto, aparecem as iniciais -->
    <figure class="reveal mx-auto w-full max-w-md">
      <div class:list={['relative overflow-hidden rounded-[32px] bg-mist', photo ? 'aspect-[3/4]' : 'aspect-square']}>
        {
          photo ? (
            <Picture
              src={photo}
              alt={`Foto de ${names}`}
              formats={['avif', 'webp']}
              widths={[360, 540, 720, 960, 1140]}
              sizes="(min-width: 768px) 448px, 90vw"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          ) : (
            <div class="dot-grid absolute inset-0 grid place-items-center" aria-hidden="true">
              <span class="flex">
                {site.founders.map((f, i) => (
                  <span
                    class:list={[
                      'grid size-28 place-items-center rounded-full bg-paper font-display text-4xl font-semibold tracking-tight text-steel ring-1 ring-ink/[0.06] sm:size-32 sm:text-5xl',
                      i > 0 && '-ml-5',
                    ]}
                  >
                    {initials(f.name)}
                  </span>
                ))}
              </span>
            </div>
          )
        }
      </div>
      <figcaption class="mt-4 px-1">
        <span class="block font-display text-lg leading-snug font-semibold text-ink">{names}</span>
        <span class="block text-sm text-graphite">Sócios-fundadores da iEasy</span>
      </figcaption>
    </figure>

    <div class="reveal">
      <p class="eyebrow">Quem somos</p>
      <h2 id="sobre-title" class="section-title mt-4">Atendimento próximo, do primeiro contato à entrega.</h2>
      <div class="lead mt-6 space-y-4">
        <p>
          A iEasy é dos sócios {site.founders.map((f) => f.short).join(' e ')}, que cuidam de cada atendimento.
        </p>
        <p>
          Comprar produtos Apple aqui é simples: conversa direta pelo WhatsApp, informação clara sobre cada aparelho e entrega em mãos, no local e horário combinados.
        </p>
        <p>
          Atendemos {hoursInline}.
        </p>
      </div>
      <a href={waGeneral()} target="_blank" rel="noopener" class="btn btn-primary mt-8">
        <Icon name="whatsapp" class="size-5" />
        Falar com a equipe
      </a>
    </div>
  </div>
</section>
