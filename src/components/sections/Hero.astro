---
import Icon from '../Icon.astro';
import LogoMark from '../LogoMark.astro';
import { hoursInline, waGeneral } from '../../data/site';
import { products } from '../../data/products';

const title = 'Produtos Apple originais e lacrados, com entrega em Alphaville e região.';
const words = title.split(' ');
// a sequência de entrada continua depois do título
const after = words.length;
---
<section class="relative overflow-hidden pt-28 pb-10 sm:pt-36 sm:pb-14 lg:pt-40 lg:pb-16" aria-labelledby="hero-title">
  <!-- fundo: grade pontilhada com fade -->
  <div class="intro-fade dot-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_70%_60%_at_70%_40%,black,transparent)]" aria-hidden="true"></div>

  <div class="container-x relative grid items-center gap-14 lg:grid-cols-[1.2fr_0.8fr] lg:gap-8">
    <div class="max-w-2xl">
      <p class="intro eyebrow" style="--i:0">Alphaville, região e São Paulo</p>
      <h1 id="hero-title" class="mt-5 text-[2.5rem] leading-[1.02] font-semibold sm:text-6xl lg:text-[4rem]">
        {words.map((w, i) => (
          <>
            <span class="intro-word" style={`--i:${i}`}>{w}</span>{i < words.length - 1 && ' '}
          </>
        ))}
      </h1>
      <p class="intro lead mt-6 max-w-xl" style={`--i:${after}`}>
        Condições competitivas, Pix ou até 10x sem juros e um atendimento próximo, do primeiro contato até a entrega em mãos.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={waGeneral()} target="_blank" rel="noopener" class="intro btn btn-primary min-h-14 px-7 text-base" style={`--i:${after + 2}`}>
          <Icon name="whatsapp" class="size-5" />
          Falar no WhatsApp
        </a>
        <a href="#produtos" class="intro btn btn-ghost min-h-14 px-7 text-base" style={`--i:${after + 3}`}>
          Ver produtos
          <Icon name="arrow" class="btn-arrow size-4" />
        </a>
      </div>
      <p class="intro mt-6 text-sm text-graphite" style={`--i:${after + 5}`}>Atendimento {hoursInline}.</p>
    </div>

    <!-- Composição visual: aparelho ilustrativo com profundidade (troque por foto quando houver) -->
    <div class="relative mx-auto h-[440px] w-full max-w-[420px] sm:h-[520px]" data-stage aria-hidden="true">
      <!-- halo de luz atrás do aparelho -->
      <div class="halo pointer-events-none absolute top-1/2 left-1/2 size-[360px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgb(0_0_0/0.10),transparent_65%)] sm:size-[440px]"></div>

      <div class="parallax-slow absolute inset-0">
        <!-- tablet ao fundo -->
        <div class="layer absolute top-6 right-0" data-depth="8">
          <div class="anim-tablet h-[300px] w-[230px] rounded-[30px] border border-ink/10 bg-mist p-3 shadow-[0_30px_60px_-30px_rgb(0_0_0/0.35)] sm:h-[360px] sm:w-[270px]">
            <div class="h-full w-full rounded-[22px] bg-paper"></div>
          </div>
        </div>

        <!-- telefone principal -->
        <div class="layer absolute top-12 left-1/2 sm:top-10" data-depth="18">
          <div class="anim-phone relative h-[400px] w-[196px] -translate-x-[62%] rounded-[42px] bg-ink p-[7px] shadow-[0_50px_80px_-30px_rgb(0_0_0/0.55),0_0_0_1px_rgb(0_0_0/0.9)] sm:h-[460px] sm:w-[226px] sm:rounded-[48px]">
            <div class="relative h-full w-full overflow-hidden rounded-[36px] bg-[radial-gradient(120%_80%_at_30%_10%,#1a1a1a,#000_70%)] sm:rounded-[41px]">
              <div class="absolute top-3 left-1/2 h-[22px] w-[74px] -translate-x-1/2 rounded-full bg-ink ring-1 ring-paper/5"></div>
              <div class="sheen absolute inset-0 bg-[linear-gradient(115deg,transparent_35%,rgb(255_255_255/0.10)_48%,transparent_60%)]"></div>
              <div class="absolute inset-0 grid place-items-center">
                <div class="anim-mark">
                  <LogoMark class="h-24 w-auto text-paper sm:h-28" />
                </div>
              </div>
              <div class="anim-bar absolute inset-x-6 bottom-8 h-1 overflow-hidden rounded-full bg-paper/15">
                <div class="h-full w-full origin-left rounded-full bg-paper/50"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- selos em vidro fosco -->
        <div class="layer absolute top-[14%] -left-1 sm:-left-6" data-depth="30">
          <div class="anim-chip" style="--c:0">
            <div class="glass float-a flex items-center gap-2.5 rounded-2xl px-4 py-3 shadow-[0_16px_40px_-18px_rgb(0_0_0/0.4)] ring-1 ring-ink/[0.06]">
              <span class="grid size-8 place-items-center rounded-full bg-ink text-paper"><Icon name="check" class="size-4" strokeWidth={2} /></span>
              <span class="text-sm leading-tight font-medium text-ink">Original<br /><span class="font-normal text-graphite">e lacrado</span></span>
            </div>
          </div>
        </div>
        <div class="layer absolute right-0 bottom-[22%] sm:-right-4" data-depth="26">
          <div class="anim-chip" style="--c:1">
            <div class="glass float-b flex items-center gap-2.5 rounded-2xl px-4 py-3 shadow-[0_16px_40px_-18px_rgb(0_0_0/0.4)] ring-1 ring-ink/[0.06]">
              <span class="grid size-8 place-items-center rounded-full bg-ink text-paper"><Icon name="map-pin" class="size-4" /></span>
              <span class="text-sm leading-tight font-medium text-ink">Entrega em mãos<br /><span class="font-normal text-graphite">Alphaville e região</span></span>
            </div>
          </div>
        </div>
        <div class="layer absolute bottom-[4%] left-[6%]" data-depth="22">
          <div class="anim-chip" style="--c:2">
            <div class="glass float-a flex items-center gap-2.5 rounded-2xl px-4 py-3 shadow-[0_16px_40px_-18px_rgb(0_0_0/0.4)] ring-1 ring-ink/[0.06]">
              <span class="grid size-8 place-items-center rounded-full bg-ink text-paper"><Icon name="card" class="size-4" /></span>
              <span class="text-sm leading-tight font-medium text-ink">Pix ou até<br /><span class="font-normal text-graphite">10x sem juros</span></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- faixa contínua com os produtos -->
  <div class="intro-fade marquee relative mt-14 overflow-hidden border-y border-ink/[0.06] py-4 [mask-image:linear-gradient(90deg,transparent,black_12%,black_88%,transparent)] sm:mt-20" aria-hidden="true">
    <div class="marquee-track flex w-max">
      {
        [0, 1].map(() => (
          <ul class="flex shrink-0 items-center">
            {products.map((p) => (
              <li class="flex items-center gap-6 pr-6 font-display text-base font-medium tracking-tight whitespace-nowrap text-graphite sm:text-lg">
                {p.name}
                <LogoMark class="h-3.5 w-auto text-steel" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Com "reduzir movimento" ligado: a mesma sequência, mas só com esmaecimento.
     O título fica visível desde o primeiro quadro. */
  @media (prefers-reduced-motion: reduce) {
    .intro,
    .intro-fade,
    .anim-phone,
    .anim-tablet,
    .anim-mark,
    .anim-chip {
      animation: fade-only 0.9s ease-out both;
      animation-delay: calc(var(--i, 0) * 50ms + 100ms);
    }
    .anim-phone,
    .anim-tablet {
      animation-delay: 0.4s;
    }
    .anim-mark {
      animation-delay: 0.9s;
    }
    .anim-chip {
      animation-delay: calc(var(--c) * 150ms + 1s);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Entrada: textos sobem com desfoque, em sequência */
    .intro,
    .intro-word {
      animation: intro-up 0.9s var(--ease-out-soft) both;
      animation-delay: calc(var(--i, 0) * 55ms + 120ms);
    }
    /* o título já aparece no primeiro quadro (bom para o Google): entra por foco e movimento */
    .intro-word {
      display: inline-block;
      animation-name: word-focus;
      animation-duration: 0.9s;
    }
    @keyframes word-focus {
      from {
        opacity: 0.12;
        transform: translateY(0.35em);
        filter: blur(10px);
      }
    }
    @keyframes intro-up {
      from {
        opacity: 0;
        transform: translateY(0.45em);
        filter: blur(8px);
      }
    }
    .intro.eyebrow::before {
      animation: line-grow 0.9s var(--ease-out-soft) 0.2s both;
    }
    @keyframes line-grow {
      from {
        width: 0;
      }
    }
    .intro-fade {
      animation: fade 1.6s ease-out 0.2s both;
    }
    @keyframes fade {
      from {
        opacity: 0;
      }
    }

    /* Aparelho: sobe girando levemente até a posição */
    .anim-phone {
      animation: phone-in 1.4s var(--ease-out-soft) 0.35s both;
    }
    @keyframes phone-in {
      from {
        opacity: 0;
        transform: translateY(70px) rotate(-7deg) scale(0.92);
      }
    }
    .anim-tablet {
      animation: tablet-in 1.4s var(--ease-out-soft) 0.55s both;
    }
    @keyframes tablet-in {
      from {
        opacity: 0;
        transform: translate(50px, 30px) rotate(6deg);
      }
    }
    .anim-mark {
      animation: mark-in 1s var(--ease-out-soft) 1s both;
    }
    @keyframes mark-in {
      from {
        opacity: 0;
        transform: scale(0.6);
        filter: blur(10px);
      }
    }
    .anim-bar > div {
      animation: bar 1.6s var(--ease-out-soft) 1.2s both;
    }
    @keyframes bar {
      from {
        transform: scaleX(0);
      }
    }
    /* reflexo que atravessa a tela de tempos em tempos */
    .sheen {
      animation: sheen 6s ease-in-out 2s infinite;
    }
    @keyframes sheen {
      0% {
        transform: translateX(-120%);
      }
      30%,
      100% {
        transform: translateX(120%);
      }
    }
    .halo {
      animation: halo 8s ease-in-out infinite;
    }
    @keyframes halo {
      50% {
        transform: scale(1.12);
        opacity: 0.7;
      }
    }

    /* Selos surgem um a um */
    .anim-chip {
      animation: chip-in 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      animation-delay: calc(var(--c) * 160ms + 1.1s);
    }
    @keyframes chip-in {
      from {
        opacity: 0;
        transform: translateY(16px) scale(0.85);
      }
    }

    .marquee-track {
      animation: marquee 60s linear infinite;
    }
    .marquee:hover .marquee-track {
      animation-play-state: paused;
    }
    @keyframes marquee {
      to {
        transform: translateX(-50%);
      }
    }
  }
</style>

<script>
  // Profundidade leve: as camadas seguem o cursor (apenas mouse/trackpad e sem redução de movimento).
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const ok = window.matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches;
  if (stage && ok) {
    const layers = [...stage.querySelectorAll<HTMLElement>('[data-depth]')];
    layers.forEach((l) => (l.style.transition = 'translate 0.6s cubic-bezier(0.22, 1, 0.36, 1)'));
    let raf = 0;
    window.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const x = e.clientX / window.innerWidth - 0.5;
        const y = e.clientY / window.innerHeight - 0.5;
        layers.forEach((l) => {
          const d = Number(l.dataset.depth);
          l.style.translate = `${(-x * d).toFixed(1)}px ${(-y * d).toFixed(1)}px`;
        });
      });
    });
  }
</script>
