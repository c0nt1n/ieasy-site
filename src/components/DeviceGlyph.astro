---
// Silhuetas genéricas em traço usadas como espaço reservado enquanto não há foto do produto.
import type { Category } from '../data/products';

interface Props {
  category: Category;
  class?: string;
}
const { category, class: className = '' } = Astro.props;

const glyphs: Record<Category, string> = {
  iphone:
    '<rect x="34" y="8" width="52" height="104" rx="12"/><rect x="40" y="14" width="40" height="92" rx="7" opacity=".35"/><rect x="52" y="18" width="16" height="4" rx="2"/>',
  macbook:
    '<rect x="22" y="26" width="76" height="52" rx="5"/><rect x="27" y="31" width="66" height="42" rx="2" opacity=".35"/><path d="M10 84h100l-6 8H16l-6-8Z"/>',
  ipad:
    '<rect x="24" y="12" width="72" height="96" rx="10"/><rect x="30" y="18" width="60" height="84" rx="5" opacity=".35"/>',
  airpods:
    '<rect x="30" y="44" width="60" height="50" rx="16"/><path d="M30 62h60" opacity=".5"/><circle cx="60" cy="72" r="2.5"/><path d="M46 20c-6 0-10 5-10 11s4 9 8 9v14M74 20c6 0 10 5 10 11s-4 9-8 9v14" opacity=".55"/>',
  watch:
    '<rect x="44" y="6" width="32" height="22" rx="6" opacity=".5"/><rect x="44" y="92" width="32" height="22" rx="6" opacity=".5"/><rect x="36" y="28" width="48" height="64" rx="14"/><rect x="42" y="34" width="36" height="52" rx="9" opacity=".35"/><rect x="84" y="46" width="5" height="12" rx="2"/>',
  acessorios:
    '<circle cx="60" cy="62" r="34"/><circle cx="60" cy="62" r="24" opacity=".35"/><circle cx="60" cy="24" r="6" opacity=".5"/>',
};
---
<svg
  class={className}
  viewBox="0 0 120 120"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={glyphs[category]}
/>
