---
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interTightLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Imagem da prévia ao compartilhar (URL completa). Sem ela, usa a imagem padrão com o logo. */
  image?: { src: string; width: number; height: number; alt: string };
}
const { title = site.title, description = site.description, image } = Astro.props;

// URL completa do site, incluindo o caminho base (ex.: https://usuario.github.io/ieasy-site)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = new URL(base + '/', Astro.site).toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = `${siteUrl}/og-image.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: site.name,
  description: site.description,
  url: siteUrl + '/',
  logo: `${siteUrl}/icon-512.png`,
  image: ogImage,
  telephone: `+${site.whatsapp.number}`,
  areaServed: site.areas.map((name) => ({ '@type': 'Place', name })),
  paymentAccepted: 'Pix, cartão de crédito',
  ...(site.openingHours.length ? { openingHours: site.openingHours } : {}),
  ...(site.legalName ? { legalName: site.legalName } : {}),
  ...(site.cnpj ? { taxID: site.cnpj } : {}),
  ...(site.instagram ? { sameAs: [site.instagram] } : {}),
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interTightLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image?.src ?? ogImage} />
    <meta property="og:image:width" content={String(image?.width ?? 1200)} />
    <meta property="og:image:height" content={String(image?.height ?? 630)} />
    <meta property="og:image:alt" content={image?.alt ?? 'Logo da iEasy'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">
      Pular para o conteúdo
    </a>
    <slot />

    <script>
      // Revela os elementos .reveal quando entram na tela. Os que entram juntos aparecem em cascata.
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            let i = 0;
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              el.style.setProperty('--d', `${Math.min(i++, 6) * 0.08}s`);
              el.classList.add('in');
              io.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
