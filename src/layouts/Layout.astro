---
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interTightLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import { site } from '../data/site';

// URL completa do site, incluindo o caminho base (ex.: https://usuario.github.io/ieasy-site)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = new URL(base + '/', Astro.site).toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = `${siteUrl}/og-image.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: site.name,
  alternateName: `${site.name} (antiga ${site.formerName})`,
  description: site.description,
  url: siteUrl + '/',
  logo: `${siteUrl}/icon-512.png`,
  image: ogImage,
  telephone: `+${site.whatsapp.number}`,
  areaServed: site.areas.map((name) => ({ '@type': 'Place', name })),
  paymentAccepted: 'Pix, cartão de crédito',
  ...(site.openingHours.length ? { openingHours: site.openingHours } : {}),
  ...(site.legalName ? { legalName: site.legalName } : {}),
  ...(site.cnpj ? { taxID: site.cnpj } : {}),
  ...(site.instagram ? { sameAs: [site.instagram] } : {}),
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interTightLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo da iEasy" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">
      Pular para o conteúdo
    </a>
    <slot />
  </body>
</html>
